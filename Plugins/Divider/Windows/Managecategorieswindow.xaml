<ctrl:FrostyWindow x:Class="ModCategories.Windows.ManageCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
        mc:Ignorable="d"
        Title="Manage Default Categories" Height="380" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModCategories;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="CategoryList" Grid.Row="0" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="New name (used for both Add and Rename):" Foreground="{StaticResource FontColor}" Opacity="0.7" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="NewCategoryBox" Foreground="{StaticResource FontColor}" Background="Transparent" Width="220" Height="26" Margin="0,0,8,0"/>
            <Button Content="Add" Width="70" Height="26" Click="AddButton_OnClick"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Rename" Width="80" Height="28" Margin="0,0,8,0" Click="RenameButton_OnClick"/>
            <Button Content="Remove" Width="120" Height="28" Margin="0,0,8,0" Click="RemoveButton_OnClick"/>
            <Button Content="Close" Width="90" Height="28" Click="CloseButton_OnClick"/>
        </StackPanel>
    </Grid>
</ctrl:FrostyWindow>
