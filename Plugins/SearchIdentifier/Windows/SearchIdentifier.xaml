<controls:FrostyDockableWindow x:Class="SearchIdentifier.Windows.SearchIdentifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SearchIdentifier.Windows"
        xmlns:controls="clr-namespace:Frosty.Controls;assembly=FrostyControls"
        mc:Ignorable="d"
        Title="SearchIdentifier" Height="340" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/SearchIdentifier;component/Themes/Generic.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="{StaticResource WindowBackground}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="55" />
		</Grid.RowDefinitions>
		<Grid Background="{StaticResource ListBackground}">
			<StackPanel Orientation="Vertical" Margin="20">
				<ComboBox x:Name="TypeSelector"
                          Width="300"
                          Height="26"
                          Margin="0,0,0,10"
                          SelectionChanged="TypeSelector_OnSelectionChanged"/>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
					<RadioButton x:Name="ModeById" Content="By Identifier" IsChecked="True" GroupName="Mode" Margin="0,0,16,0" Checked="Mode_OnChanged" Foreground="{StaticResource FontColor}"/>
					<RadioButton x:Name="ModeByName" Content="By Name" GroupName="Mode" Checked="Mode_OnChanged" Foreground="{StaticResource FontColor}"/>
				</StackPanel>
				<Border BorderBrush="{StaticResource ControlBackground}"
                        BorderThickness="0"
                        Margin="0,2,0,16"
                        Width="300"
                        HorizontalAlignment="Left">
					<controls:FrostyWatermarkTextBox WatermarkText="Enter Identifier..."
                                                     KeyUp="IdInput_OnKeyUp"
                                                     x:Name="IdInput"
                                                     Height="29"
                                                     VerticalContentAlignment="Center"
                                                     Width="300"/>
				</Border>
				<TextBox x:Name="ResultText"
                         Text="Pick a category and type an Identifier above."
                         Foreground="{StaticResource FontColor}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Focusable="True"
                         Width="300"/>
			</StackPanel>
		</Grid>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Button x:Name="OpenAssetButton"
                    Margin="0,0,8,0"
                    Width="100"
                    Height="30"
                    Content="Open"
                    Click="OpenAssetButton_OnClick"
                    IsEnabled="False"/>
			<Button x:Name="CloseButton"
                    Margin="0,0,0,0"
                    Width="100"
                    Height="30"
                    Content="Close"
                    Click="CloseButton_OnClick"/>
		</StackPanel>
	</Grid>
</controls:FrostyDockableWindow>